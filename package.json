{
  "name": "agent-bridge",
  "version": "2.0.0",
  "description": "Local-first async MCP bridge between Antigravity and Claude Code for collaborative planning reviews, Markdown plan export, and dev task handoffs",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "setup": "node setup.cjs",
    "check": "node setup.cjs --check",
    "uninstall": "node setup.cjs --uninstall",
    "test": "node server.cjs --selftest",
    "rooms": "node server.cjs --rooms",
    "status": "node server.cjs --status",
    "reset": "node server.cjs --reset"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "antigravity",
    "claude-code",
    "agent-bridge",
    "multi-agent",
    "ai-agents",
    "local-first",
    "pair-programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/astevegreen/agent-bridge.git"
  },
